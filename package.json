{
  "name": "dsh-native-codex-oauth",
  "version": "0.1.0-alpha.1",
  "description": "Native ChatGPT OAuth controls for DeepSeek Harness's built-in OpenAI Codex provider",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kfc966/dsh-native-codex-oauth.git"
  },
  "homepage": "https://github.com/kfc966/dsh-native-codex-oauth#readme",
  "bugs": {
    "url": "https://github.com/kfc966/dsh-native-codex-oauth/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/types/typert.d.ts",
      "default": "./lib/typert.js"
    },
    "./remote": {
      "types": "./lib/types/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "prepack": "npm run verify && npm test"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "codex",
    "oauth",
    "openai",
    "chatgpt"
  ],
  "publishConfig": {
    "access": "public"
  }
}
